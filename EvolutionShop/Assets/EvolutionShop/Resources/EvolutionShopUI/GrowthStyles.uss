/* GR-13: the greybox's own pieces in the UX tokens (GR.13, UX.3). The classic sheets (ShopTokens, HudStyles,
   CardStyles, ScreenStyles) draw the rest: the HUD's chips, notes and next-step line, cards, buttons and keycaps.
   Sizes are for the 1920x1080 reference panel. Every class starts with gr- so none overlaps a classic sheet. */

/* ---------------------------------------------------------------- the HUD */

.gr-chip--money {
    height: 88px;
}

.gr-chip__money {
    flex-direction: column;
    justify-content: center;
}

.gr-stars {
    flex-direction: row;
    align-items: center;
    margin-top: -2px;
}

.gr-star {
    width: 22px;
    height: 22px;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

.gr-stars__rp {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 16px;
    color: var(--es-muted);
    margin: 0 0 0 8px;
    padding: 0;
}

.gr-carry {
    position: absolute;
    right: 34px;
    bottom: 40px;
    padding: 10px 22px 10px 22px;
    background-color: var(--es-paper);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-width: 5px;
    border-color: var(--es-paper-lip);
}

.gr-carry__line {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 20px;
    color: var(--es-ink);
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

/* GR-18 wave 4 (the comedy): a silly moment's caption, above the next-step line: who says it, and what. */
.gr-caption {
    position: absolute;
    left: 50%;
    bottom: 128px;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    max-width: 1100px;
    padding: 10px 26px 10px 22px;
    background-color: rgba(18, 60, 56, 0.9);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.gr-caption__who {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 22px;
    color: var(--es-honey);
    margin: 0 12px 0 0;
    padding: 0;
    white-space: nowrap;
    flex-shrink: 0;
}

.gr-caption__text {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 24px;
    color: var(--es-paper);
    margin: 0;
    padding: 0;
    white-space: nowrap;
    flex-shrink: 0;
}

/* Notes at the top stay narrower than the gap beside a station card, so a long one wraps instead of reaching it. */
.gr-note {
    max-width: 600px;
}

.gr-toast--event {
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 5px;
    border-color: var(--es-teal);
}

.gr-toast--event .es-toast__text {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 28px;
}

/* ---------------------------------------------------------------- the station card's strip and tabs */

.gr-strip {
    flex-direction: column;
    align-items: stretch;
    padding-bottom: 0;
}

.gr-strip--plain {
    padding-bottom: 12px;
}

.gr-strip__top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.gr-close {
    width: 40px;
    height: 40px;
    margin: 0 0 0 10px;
    padding: 0;
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 26px;
    -unity-text-align: middle-center;
    color: var(--es-paper);
    background-color: rgba(255, 246, 223, 0.14);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    flex-shrink: 0;
}

.gr-close:hover {
    background-color: rgba(255, 246, 223, 0.3);
}

.es-card__strip--shop .gr-close {
    color: var(--es-ink);
    background-color: rgba(27, 65, 62, 0.1);
}

.gr-tabs {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 12px;
}

.gr-tab {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 24px;
    color: rgba(255, 246, 223, 0.78);
    background-color: rgba(0, 0, 0, 0);
    margin: 0 6px 0 0;
    padding: 8px 22px 10px 22px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.gr-tab:hover {
    color: var(--es-paper);
    background-color: rgba(255, 246, 223, 0.12);
}

.es-card__strip--shop .gr-tab {
    color: rgba(27, 65, 62, 0.6);
}

.es-card__strip--shop .gr-tab:hover {
    color: var(--es-ink);
    background-color: rgba(27, 65, 62, 0.08);
}

.gr-tab--on,
.gr-tab--on:hover,
.es-card__strip--shop .gr-tab--on,
.es-card__strip--shop .gr-tab--on:hover {
    color: var(--es-ink);
    background-color: var(--es-paper);
}

/* Four tabs or more (the research bench at level 4) fit beside the ? at a smaller size. */
.gr-tabs--many .gr-tab {
    font-size: 20px;
    padding: 8px 14px 10px 14px;
    margin-right: 2px;
}

.gr-info {
    width: 34px;
    height: 34px;
    margin: 0 0 8px auto;
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 21px;
    -unity-text-align: middle-center;
    color: var(--es-paper);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: rgba(255, 246, 223, 0.7);
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
    padding: 0;
}

.es-card__strip--shop .gr-info {
    color: var(--es-ink);
    border-color: rgba(27, 65, 62, 0.5);
}

/* ---------------------------------------------------------------- card bodies */

.gr-body {
    flex-direction: column;
}

.gr-section {
    margin-bottom: 16px;
}

.gr-label {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 16px;
    letter-spacing: 1.5px;
    color: var(--es-muted);
    margin: 0 0 8px 0;
    padding: 0;
    white-space: normal;
}

.gr-hint {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 18px;
    color: var(--es-muted);
    margin: 0;
    padding: 0;
    white-space: normal;
}

.gr-strong {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 24px;
    color: var(--es-ink);
    margin: 0;
    padding: 0;
    white-space: normal;
}

.gr-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.gr-row--spread {
    justify-content: space-between;
    flex-wrap: nowrap;
}

.gr-callout {
    padding: 12px 16px 14px 16px;
    margin-bottom: 16px;
    background-color: #FBE8BE;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}

.gr-newtag {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 15px;
    color: #6B4A0C;
    background-color: var(--es-honey);
    margin: 0 0 0 8px;
    padding: 2px 12px 2px 12px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.gr-wide {
    align-self: stretch;
    margin-top: 2px;
    margin-bottom: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.gr-pip {
    width: 14px;
    height: 14px;
    margin-right: 4px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

/* A text link: a button drawn as underlined teal words. */
.gr-link {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 19px;
    color: var(--es-teal);
    background-color: rgba(0, 0, 0, 0);
    margin: 0 0 0 16px;
    padding: 0 0 2px 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-color: var(--es-teal);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.gr-link:hover {
    color: var(--es-teal-hover);
    border-color: var(--es-teal-hover);
}

.gr-link:disabled {
    color: #B5AB91;
    border-color: #CFC6AE;
}

.gr-foot {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding-top: 12px;
    border-top-width: 2px;
    border-color: var(--es-paper-deep);
}

.gr-foot__text {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 17px;
    color: var(--es-muted);
    margin: 0 0 0 8px;
    padding: 0;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

/* ---------------------------------------------------------------- tiles, chips and slots */

.gr-tile {
    width: 146px;
    margin: 0 10px 10px 0;
    padding: 8px 10px 8px 12px;
    flex-direction: column;
    align-items: flex-start;
    background-color: #FFFDF6;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--es-paper-deep);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    transition-property: border-color;
    transition-duration: 0.1s;
}

.gr-tile:hover {
    border-color: var(--es-teal);
}

.gr-tile:disabled {
    opacity: 0.78;
}

.gr-tile--unknown {
    background-color: var(--es-paper-deep);
}

.gr-tile__glyph {
    width: 58px;
    height: 34px;
}

.gr-tile__name {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 22px;
    color: var(--es-ink);
    margin: 2px 0 0 0;
    padding: 0;
    white-space: nowrap;
}

.gr-tile__meta {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.gr-tile__time {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 15px;
    color: var(--es-muted);
    margin: 0 0 0 4px;
    padding: 0;
}

.gr-dose {
    flex-direction: row;
    align-items: center;
    margin: 0 10px 10px 0;
    padding: 6px 8px 6px 8px;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.gr-dose__text {
    flex-direction: column;
    margin: 0 10px 0 10px;
    min-width: 92px;
}

.gr-dose__name {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 22px;
    color: var(--es-ink);
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

.gr-dose__count {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 15px;
    color: var(--es-muted);
    margin: -2px 0 0 0;
    padding: 0;
    white-space: nowrap;
}

.gr-pm {
    width: 38px;
    height: 38px;
    margin: 0;
    padding: 0 0 2px 0;
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 26px;
    -unity-text-align: middle-center;
    color: var(--es-teal);
    background-color: #FFFFFF;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--es-teal);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.gr-pm:hover {
    background-color: #E9F2F0;
}

.gr-pm:disabled {
    color: #B5AB91;
    border-color: #CFC6AE;
    background-color: rgba(255, 255, 255, 0.5);
}

.gr-chip {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 17px;
    color: var(--es-teal);
    background-color: #E9F2F0;
    margin: 8px 8px 0 0;
    padding: 3px 12px 3px 12px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    white-space: nowrap;
}

.gr-chip--miss {
    color: var(--es-coral-ink);
    background-color: var(--es-coral-soft);
}

.gr-chip--button {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.gr-chip--button:hover {
    background-color: #D6EDE7;
}

.gr-chip--button:disabled {
    color: #B5AB91;
    background-color: rgba(233, 242, 240, 0.6);
}

.gr-meter {
    flex-direction: row;
    align-items: center;
}

.gr-meter__seg {
    width: 44px;
    height: 14px;
    margin-left: 8px;
    background-color: #E4D8BA;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.gr-meter__seg--on {
    background-color: var(--es-honey);
}

/* ---------------------------------------------------------------- the Upgrade tab */

.gr-upgrade {
    margin-bottom: 18px;
}

.gr-upgrade__head {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 22px;
    color: var(--es-ink);
    margin: 0 0 10px 0;
    padding: 0;
}

.gr-track {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.gr-lv {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 21px;
    -unity-text-align: middle-center;
    color: var(--es-muted);
    background-color: var(--es-paper-deep);
    margin: 0;
    padding: 0;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.gr-lv--done {
    color: var(--es-paper);
    background-color: var(--es-teal);
}

.gr-lv--next {
    color: var(--es-teal);
    background-color: #FFFFFF;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-color: var(--es-teal);
}

.gr-lv-line {
    flex-grow: 1;
    height: 5px;
    margin: 0 6px 0 6px;
    background-color: var(--es-paper-deep);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.gr-lv-line--done {
    background-color: var(--es-teal);
}

.gr-benefit {
    padding: 12px 16px 14px 16px;
    margin-bottom: 12px;
    background-color: #FFFFFF;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--es-paper-deep);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}

.gr-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 2px;
}

/* ---------------------------------------------------------------- containers */

.gr-spaces {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.gr-space {
    height: 64px;
    margin: 0 8px 14px 0;
    align-items: center;
    justify-content: center;
    background-color: #E9F2F0;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: #CFE2DE;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.gr-space--empty {
    background-color: rgba(0, 0, 0, 0);
    border-color: #CDBF9B;
}

.gr-space--sold {
    opacity: 0.5;
}

.gr-space__glyph {
    width: 54px;
    height: 32px;
}

.gr-badge {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: -11px;
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 13px;
    -unity-text-align: middle-center;
    color: var(--es-ink);
    background-color: var(--es-honey);
    margin: 0;
    padding: 0 0 1px 0;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.gr-face {
    width: 46px;
    height: 46px;
    margin-right: 14px;
    flex-shrink: 0;
}

/* ---------------------------------------------------------------- the breeding tank */

.gr-pair {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.gr-parent {
    flex-grow: 1;
    flex-basis: 0;
    height: 112px;
    margin: 0;
    padding: 8px 8px 8px 8px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: #FFFFFF;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--es-paper-deep);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}

.gr-parent:hover {
    border-color: var(--es-teal);
}

.gr-parent--empty {
    background-color: rgba(0, 0, 0, 0);
    border-color: #CDBF9B;
}

.gr-parent--empty:hover {
    border-color: #CDBF9B;
}

.gr-parent__glyph {
    width: 72px;
    height: 42px;
}

.gr-times {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 40px;
    color: var(--es-muted);
    margin: 0 10px 0 10px;
    padding: 0;
}

.gr-ring {
    width: 132px;
    height: 132px;
    flex-shrink: 0;
    margin-right: 18px;
    align-items: center;
    justify-content: center;
}

.gr-ring__time {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 34px;
    color: var(--es-ink);
    margin: 0;
    padding: 0;
}

.gr-result {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px 10px 14px;
    margin-bottom: 10px;
    background-color: #E9F2F0;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.gr-result__glyph {
    width: 60px;
    height: 36px;
    margin-right: 12px;
    flex-shrink: 0;
}

.gr-result__text {
    flex-shrink: 1;
    flex-grow: 1;
}

/* ================================================================ wave 2: the machines */

.gr-pill {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 16px;
    margin: 0 8px 0 8px;
    padding: 3px 12px 3px 12px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    white-space: normal;
    max-width: 220px;
    flex-shrink: 1;
}

.gr-pill--go {
    color: var(--es-teal);
    background-color: #D6EDE7;
}

.gr-pill--slow {
    color: #7A5410;
    background-color: #FBE8BE;
}

.gr-pill--wait {
    color: var(--es-coral-ink);
    background-color: var(--es-coral-soft);
}

.gr-bar {
    flex-direction: row;
    height: 22px;
    margin-bottom: 10px;
    background-color: #E4D8BA;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    overflow: hidden;
    flex-shrink: 0;
}

.gr-bar__fill {
    height: 100%;
}

.gr-item {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 8px 12px 8px 12px;
    background-color: #FFFFFF;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--es-paper-deep);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.gr-item--off {
    opacity: 0.7;
}

.gr-item__title {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 22px;
    color: var(--es-ink);
    margin: 0;
    padding: 0;
    white-space: normal;
}

.gr-item .es-button {
    margin-top: 0;
    margin-right: 0;
    margin-left: 8px;
}

.gr-item .gr-chip--button {
    margin-top: 0;
}

.gr-stat {
    margin-bottom: 10px;
}

.gr-stat__number {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 40px;
    color: var(--es-ink);
    margin: 0;
    padding: 0;
}

.gr-picker {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
    padding: 8px 8px 8px 8px;
    background-color: #FFFFFF;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--es-paper-deep);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}

.gr-picker__words {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
    margin: 0 6px 0 6px;
}

.gr-avatar {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    margin-right: 14px;
    align-items: center;
    justify-content: center;
    background-color: var(--es-teal);
    border-top-left-radius: 26px;
    border-top-right-radius: 26px;
    border-bottom-left-radius: 26px;
    border-bottom-right-radius: 26px;
}

.gr-avatar__letter {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 28px;
    color: var(--es-paper);
    margin: 0;
    padding: 0;
}

.gr-check {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.gr-check__box {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    margin-right: 12px;
    align-items: center;
    justify-content: center;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--es-teal);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.gr-check__box--on {
    background-color: var(--es-teal);
}

.gr-check__mark {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 18px;
    color: var(--es-paper);
    margin: 0;
    padding: 0;
}

.gr-check__text {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 19px;
    color: var(--es-ink);
    margin: 0;
    padding: 0;
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

/* ---------------------------------------------------------------- the placement mode bar */

.gr-mode {
    position: absolute;
    left: 50%;
    bottom: 46px;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 14px 24px 14px 24px;
    background-color: rgba(18, 60, 56, 0.94);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
}

.gr-mode__words {
    margin-right: 22px;
}

.gr-mode__title {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 28px;
    color: var(--es-paper);
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

.gr-mode__detail {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 19px;
    color: var(--es-honey);
    margin: 0;
    padding: 0;
    white-space: nowrap;
}

.gr-mode__key {
    flex-direction: row;
    align-items: center;
    margin-left: 18px;
}

.gr-mode__keytext {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 20px;
    color: var(--es-paper);
    margin: 0 0 0 8px;
    padding: 0;
}

/* ================================================================ wave 3: the planning views (notebooks) */

.gr-notebook {
    flex-direction: column;
    background-color: var(--es-paper);
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-left-radius: 34px;
    border-bottom-right-radius: 34px;
    border-bottom-width: 9px;
    border-color: var(--es-paper-lip);
    overflow: hidden;
}

.gr-nb__head {
    flex-direction: row;
    align-items: flex-end;
    padding: 28px 40px 0 44px;
    flex-shrink: 0;
}

.gr-nb__title {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 52px;
    color: var(--es-ink);
    margin: 0;
    padding: 0;
}

.gr-nb__subtitle {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 21px;
    color: var(--es-muted);
    margin: 0 0 12px 22px;
    padding: 0;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.gr-nb__close {
    color: var(--es-ink);
    background-color: rgba(27, 65, 62, 0.08);
    margin-bottom: 10px;
}

.gr-nb__close:hover {
    background-color: rgba(27, 65, 62, 0.16);
}

.gr-nb__tabs {
    flex-direction: row;
    padding: 16px 36px 0 36px;
    border-bottom-width: 4px;
    border-color: var(--es-paper-deep);
    flex-shrink: 0;
}

.gr-nb-tab {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 26px;
    color: var(--es-muted);
    background-color: var(--es-paper-deep);
    margin: 0 8px 0 0;
    padding: 10px 24px 10px 24px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.gr-nb-tab:hover {
    color: var(--es-ink);
}

.gr-nb-tab.gr-tab--on,
.gr-nb-tab.gr-tab--on:hover {
    color: var(--es-paper);
    background-color: var(--es-teal);
}

.gr-nb-tab--locked {
    opacity: 0.6;
}

.gr-nb__body {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 26px 44px 18px 44px;
}

.gr-nb__foot {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 12px 44px 24px 44px;
}

.gr-nb__foot .gr-hint {
    margin-left: 16px;
}

/* ---------------------------------------------------------------- pinned papers */

.gr-papers {
    flex-direction: row;
    align-items: flex-start;
}

.gr-paper {
    flex-grow: 1;
    flex-basis: 0;
    margin: 18px 14px 0 14px;
    padding: 26px 26px 22px 26px;
    background-color: #FFFDF6;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-width: 4px;
    border-color: #E4D8BA;
}

.gr-paper__pin {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 28px;
    height: 28px;
    translate: -50% 0;
    background-color: var(--es-coral);
    border-bottom-width: 4px;
    border-color: #9E3F2A;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.gr-paper__sub {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 17px;
    letter-spacing: 1.5px;
    color: var(--es-muted);
    margin: 0 0 6px 0;
    padding: 0;
    white-space: normal;
}

.gr-paper__title {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 30px;
    color: var(--es-ink);
    margin: 0 0 12px 0;
    padding: 0;
    white-space: normal;
}

.gr-rings {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 12px;
}

.gr-goalring {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
}

.gr-goalring .gr-hint {
    -unity-text-align: middle-center;
    font-size: 16px;
}

.gr-ring--small {
    width: 88px;
    height: 88px;
    margin-right: 0;
    margin-bottom: 6px;
}

.gr-ring--small .gr-ring__time {
    font-size: 26px;
}

/* ---------------------------------------------------------------- item cards (the catalog, research, cultures) */

.gr-items {
    flex-direction: row;
    flex-wrap: wrap;
}

.gr-shopitem {
    width: 32%;
    margin: 0 1.3% 18px 0;
    padding: 16px 18px 16px 18px;
    background-color: #FFFFFF;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--es-paper-deep);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}

.gr-shopitem--locked {
    opacity: 0.65;
}

.gr-shopitem__picture {
    height: 84px;
    margin-bottom: 10px;
    align-items: center;
    justify-content: center;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.gr-shopitem__dot {
    width: 46px;
    height: 46px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-width: 4px;
    border-bottom-width: 4px;
    border-color: rgba(255, 255, 255, 0.7);
    border-top-left-radius: 23px;
    border-top-right-radius: 23px;
    border-bottom-left-radius: 23px;
    border-bottom-right-radius: 23px;
}

.gr-shopitem__name {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 26px;
    color: var(--es-ink);
    margin: 0 0 4px 0;
    padding: 0;
    white-space: normal;
}

.gr-shopitem__price {
    margin-top: 8px;
}

.gr-shopitem__amount {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 24px;
    color: var(--es-ink);
    margin: 0 0 0 8px;
    padding: 0;
}

.gr-coin {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---------------------------------------------------------------- the journal */

.gr-shelf {
    margin-bottom: 16px;
}

.gr-shelf__head {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 26px;
    color: var(--es-ink);
    margin: 0 0 8px 0;
    padding: 0;
}

.gr-shelf__row {
    flex-direction: row;
}

.gr-jt {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 12px;
    padding: 8px 6px 8px 6px;
    align-items: center;
    background-color: #FFFFFF;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-color: var(--es-paper-deep);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
}

.gr-jt--unknown {
    background-color: var(--es-paper-deep);
}

.gr-jt--crown {
    border-color: var(--es-honey);
}

.gr-jt__glyph {
    width: 64px;
    height: 36px;
}

.gr-jt__name {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 19px;
    color: var(--es-ink);
    margin: 2px 0 0 0;
    padding: 0;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.gr-jt__hint {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 13px;
    color: var(--es-muted);
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-text-align: middle-center;
}

.gr-jt__dots {
    flex-direction: row;
    margin-top: 4px;
}

.gr-jt__dot {
    width: 13px;
    height: 13px;
    margin: 0 2px 0 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-color: #CDBF9B;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.gr-jt__dot--got {
    border-color: rgba(0, 0, 0, 0);
}

.gr-pager {
    justify-content: center;
    margin-top: 4px;
}

.gr-pager__words {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 19px;
    color: var(--es-muted);
    margin: 0 16px 0 16px;
    padding: 0;
}

.gr-logrows {
    flex-direction: row;
    flex-wrap: wrap;
}

.gr-logrow {
    width: 33%;
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.gr-logrow__text {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 18px;
    color: var(--es-ink);
    margin: 0 0 0 6px;
    padding: 0;
    white-space: normal;
    flex-shrink: 1;
}

/* ---------------------------------------------------------------- the receipt and the welcome */

.gr-receipt {
    padding: 22px 26px 20px 26px;
    margin-bottom: 14px;
    background-color: #FFFDF6;
    border-bottom-width: 4px;
    border-color: #E4D8BA;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.gr-step {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.gr-step__number {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    margin: 0 14px 0 0;
    padding: 0;
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Baloo2-ExtraBold.ttf");
    font-size: 21px;
    -unity-text-align: middle-center;
    color: var(--es-paper);
    background-color: var(--es-teal);
    border-top-left-radius: 19px;
    border-top-right-radius: 19px;
    border-bottom-left-radius: 19px;
    border-bottom-right-radius: 19px;
}

.gr-step__text {
    -unity-font-definition: url("/Assets/EvolutionShop/UI/Fonts/Nunito-ExtraBold.ttf");
    font-size: 20px;
    color: var(--es-ink);
    margin: 0;
    padding: 0;
    white-space: normal;
    flex-shrink: 1;
}

/* The next step is one line: a wrapping label measured a hair narrower than it draws at some scales, so its last word fell under the card. */
.gr-next .es-next__text {
    white-space: nowrap;
    flex-shrink: 0;
    max-width: 900px;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* GR-14: the guided first night's marker (HudStyles' es-arrow): above the thing to use, its label on top of the disc. */
.gr-guide {
    position: absolute;
}

.gr-guide--over {
    flex-direction: column-reverse;
}

.gr-guide--over .es-arrow__label {
    margin: 0 0 6px 0;
}
