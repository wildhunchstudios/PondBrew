<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="es-hud" class="es-hud">
        <ui:VisualElement name="es-hud-world" class="es-hud">
            <ui:VisualElement name="es-hud-arrows" class="es-hud" />
            <ui:VisualElement name="es-hud-marker" class="es-marker es-hud-item">
                <ui:Label name="es-hud-marker-title" class="es-marker__title" text="" />
                <ui:Label name="es-hud-marker-action" class="es-marker__action" text="" />
            </ui:VisualElement>
            <ui:VisualElement name="es-hud-bubble" class="es-bubble es-hud-item">
                <ui:Label name="es-hud-bubble-text" class="es-bubble__text" text="" />
                <ui:VisualElement class="es-bubble__skip">
                    <ui:Label name="es-hud-bubble-key" class="es-keycap" text="Backspace" />
                    <ui:Label name="es-hud-bubble-hint" class="es-text es-text--muted" text="" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="es-hud-day" class="es-chip es-chip--day es-hud-item">
            <ui:VisualElement name="es-hud-day-icon" class="es-chip__icon" />
            <ui:VisualElement class="es-chip__text">
                <ui:Label name="es-hud-day-title" class="es-chip__title" text="" />
                <ui:Label name="es-hud-day-detail" class="es-chip__detail" text="" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="es-hud-queue" class="es-queue es-hud-item" />
        <ui:VisualElement name="es-hud-money" class="es-chip es-chip--money es-hud-item">
            <ui:VisualElement name="es-hud-money-icon" class="es-chip__icon" />
            <ui:Label name="es-hud-money-amount" class="es-chip__amount" text="" />
        </ui:VisualElement>
        <ui:VisualElement name="es-hud-floaters" class="es-floaters" />
        <ui:VisualElement name="es-hud-top" class="es-hud-top">
            <ui:VisualElement name="es-hud-toasts" />
            <ui:VisualElement name="es-hud-discovery" class="es-stamp es-hud-item">
                <ui:Label name="es-hud-discovery-title" class="es-stamp__title" text="" />
                <ui:Label name="es-hud-discovery-name" class="es-stamp__name" text="" />
                <ui:VisualElement name="es-hud-discovery-recipe" class="es-stamp__recipe" />
                <ui:Label name="es-hud-discovery-note" class="es-stamp__note" text="" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="es-hud-crosshair" class="es-crosshair" />
        <ui:VisualElement name="es-hud-prompts" class="es-prompts">
            <ui:VisualElement name="es-hud-prompt" class="es-prompt es-hud-item">
                <ui:Label name="es-hud-prompt-key" class="es-keycap" text="E" />
                <ui:Label name="es-hud-prompt-key2" class="es-keycap" text="" />
                <ui:Label name="es-hud-prompt-name" class="es-prompt__name" text="" />
                <ui:Label name="es-hud-prompt-status" class="es-prompt__status" text="" />
                <ui:VisualElement name="es-hud-prompt-progress" class="es-prompt__progress" />
            </ui:VisualElement>
            <ui:VisualElement name="es-hud-slap" class="es-prompt es-prompt--slap es-hud-item">
                <ui:Label name="es-hud-slap-key" class="es-keycap" text="F" />
                <ui:Label name="es-hud-slap-name" class="es-prompt__name" text="" />
                <ui:Label name="es-hud-slap-status" class="es-prompt__status" text="" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="es-hud-next" class="es-next">
            <ui:VisualElement name="es-hud-next-card" class="es-next__card es-hud-item">
                <ui:VisualElement name="es-hud-next-icon" class="es-next__icon" />
                <ui:Label name="es-hud-next-text" class="es-next__text" text="" />
                <ui:Label name="es-hud-next-help" class="es-keycap es-next__help" text="F1" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
