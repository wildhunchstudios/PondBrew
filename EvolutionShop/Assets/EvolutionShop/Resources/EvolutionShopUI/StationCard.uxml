<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="es-station-card" class="es-card" picking-mode="Position">
        <ui:VisualElement name="es-card-strip" class="es-card__strip">
            <ui:Label name="es-card-title" class="es-card__title" text="Station" />
            <ui:Label name="es-card-status" class="es-card__status" text="" />
        </ui:VisualElement>
        <ui:VisualElement name="es-card-content" class="es-card__body">
            <ui:Label name="es-card-body" class="es-text" text="" />
            <ui:Button name="es-card-close" class="es-button es-button--primary" text="Close" />
            <ui:VisualElement class="es-row es-card__hint">
                <ui:Label name="es-card-keycap" class="es-keycap" text="Esc" />
                <ui:Label name="es-card-hint" class="es-text es-text--muted" text="" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
